# The prior on the skyline rates, shared by every analysis so that no two arms of a
# comparison can drift apart. dnFBDRP, dnBDS and anything else source this file.
#
# It is PyRate's: an independent gamma for each rate in each interval. The simulator draws
# from the same one, through the same keys. A speciation or extinction rate parameter the
# batch leaves unset was drawn per replicate from Uniform(0, GAMMA_RATE_MAX), so it is
# estimated here.
if (GAMMA_L_RATE > 0) {
    gamma_rate_lambda <- GAMMA_L_RATE
} else {
    gamma_rate_lambda ~ dnUniform(0, GAMMA_RATE_MAX)
    moves.append( mvScale(gamma_rate_lambda, lambda=0.5, weight=2) )
}
if (GAMMA_M_RATE > 0) {
    gamma_rate_mu <- GAMMA_M_RATE
} else {
    gamma_rate_mu ~ dnUniform(0, GAMMA_RATE_MAX)
    moves.append( mvScale(gamma_rate_mu, lambda=0.5, weight=2) )
}
if (SKYLINE) {
    timeline <- readDataDelimitedFile(BATCHDIR + "/times/times_" + rep + ".tsv")[1]
    n_int <- timeline.size() + 1
    for (i in 1:n_int) {
        lambda[i] ~ dnGamma(GAMMA_L_SHAPE, gamma_rate_lambda)
        moves.append( mvSlice(lambda[i], window=0.1, weight=1, search_method="stepping_out") )
        mu[i] ~ dnGamma(GAMMA_M_SHAPE, gamma_rate_mu)
        moves.append( mvSlice(mu[i], window=0.1, weight=1, search_method="stepping_out") )
        psi[i] ~ dnGamma(GAMMA_P_SHAPE, GAMMA_P_RATE)
        moves.append( mvSlice(psi[i], window=0.1, weight=1, search_method="stepping_out") )
    }
} else {
    lambda ~ dnGamma(GAMMA_L_SHAPE, gamma_rate_lambda)
    mu ~ dnGamma(GAMMA_M_SHAPE, gamma_rate_mu)
    psi ~ dnGamma(GAMMA_P_SHAPE, GAMMA_P_RATE)
    moves.append( mvScale(lambda, weight=3) )
    moves.append( mvScale(mu, weight=3) )
    moves.append( mvScale(psi, weight=3) )
}
