### Parameterized FBD-range (skyline) inference over the current dnFBDRMatrix
### model set. Expects these variables to be set by a per-rep aux file sourced
### BEFORE this script (run_sbc.sh writes them):
###   rep (String), SKYLINE, COMPLETE, BINARY (Bool), COND (String), RHO (Real),
###   DATADIR, OUTDIR (String)
### PRIORS block below must stay in sync with sim_sbc.r (config.sh LMEAN/LSD/...).

taxa <- readTaxonData(DATADIR + "/specimens/taxa_" + rep + ".tsv")

moves = VectorMoves()

# ---- PRIORS (keep in sync with sim_sbc.r) ----
if (SKYLINE) {
    timeline <- readDataDelimitedFile(DATADIR + "/times/times_" + rep + ".tsv")[1]
    n_int <- timeline.size() + 1
    for (i in 1:n_int) {
        lambda[i] ~ dnLognormal(-2, 0.5)
        moves.append( mvSlice(lambda[i], window=0.1, weight=1, search_method="stepping_out") )
        mu[i] ~ dnLognormal(-2, 0.5)
        moves.append( mvSlice(mu[i], window=0.1, weight=1, search_method="stepping_out") )
        psi[i] ~ dnLognormal(-0.125, 0.5)
        moves.append( mvSlice(psi[i], window=0.1, weight=1, search_method="stepping_out") )
    }
} else {
    lambda ~ dnLognormal(-2, 0.5)
    mu ~ dnLognormal(-2, 0.5)
    psi ~ dnLognormal(-0.125, 0.5)
    moves.append( mvScale(lambda, weight=3) )
    moves.append( mvScale(mu, weight=3) )
    moves.append( mvScale(psi, weight=3) )
}

# ---- likelihood over the CURRENT dnFBDRMatrix model set ----
# args available in this rb build: lambda mu psi rho taxa timeline complete
# condition resample BDS  (NB: there is NO 'binary' arg in this build)
if (SKYLINE) {
    bd ~ dnFBDRMatrix(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=RHO,
                      timeline=timeline, condition=COND, complete=COMPLETE, BDS=BDS)
} else {
    bd ~ dnFBDRMatrix(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=RHO,
                      condition=COND, complete=COMPLETE, BDS=BDS)
}

moves.append( mvMatrixElementScale(bd, lambda=0.1, weight=taxa.size()/10) )
moves.append( mvMatrixElementSlide(bd, delta=0.1, weight=taxa.size()/10) )

mymodel = model(bd)
monitors = VectorMonitors()
monitors.append( mnModel(filename=OUTDIR + "/fbd_" + rep + ".log", printgen=PRINTGEN) )
mymcmc = mcmc(mymodel, monitors, moves)
mymcmc.run(generations=GENS)
q()
