### Skyline FBD-range inference over dnFBDRP, with the record on a dnFossilRecord node.
###
### Every prior hyperparameter arrives as a variable set by the per-rep aux file that
### bin/run.sh generates from the batch config.sh. Nothing is hardcoded here: the batch
### that generated the data and the analysis that fits it read one definition, so they
### cannot drift apart.
###
### Set before sourcing: rep, SKYLINE, COMPLETE, COND, RHO, GENS, PRINTGEN,
###   SPECIMENS, BATCHDIR, OUTDIR, LMEAN, LSD, MMEAN, MSD, PMEAN, PSD, AGE_MIN, AGE_MAX,
###   ORIGIN_PRIOR, MAXFA, SURVIVORS

taxa <- readTaxonData(BATCHDIR + "/" + SPECIMENS + "/taxa_" + rep + ".tsv")

moves = VectorMoves()

# an aux file written before the GMRF existed does not set this
if (!exists("GMRF_SD")) GMRF_SD <- 0
# the hierarchical variant draws the walk width per replicate, so estimate it here
if (!exists("GMRF_SD_MEAN")) GMRF_SD_MEAN <- -1
if (!exists("GMRF_SD_SD")) GMRF_SD_SD <- 0
if (!exists("GMRF_PSI_MEAN")) GMRF_PSI_MEAN <- -1
if (!exists("GMRF_PSI_SD")) GMRF_PSI_SD <- 0
GMRF_HIER <- (GMRF_SD_SD > 0)
# stationary AR(1) alternative, on log lambda and log turnover rather than log mu
if (!exists("OU_PHI")) OU_PHI <- -1
if (!exists("TMEAN")) TMEAN <- 0
if (!exists("TSD")) TSD <- 0.3
OU <- (OU_PHI >= 0)
# an aux file written before truncation existed does not set this
if (!exists("PRESENT")) PRESENT <- 0
# an aux file written before thinning existed does not set this
if (!exists("REPORT_PROB")) REPORT_PROB <- 1.0

if (SKYLINE) {
    timeline <- readDataDelimitedFile(BATCHDIR + "/times/times_" + rep + ".tsv")[1]
    n_int <- timeline.size() + 1
    if (OU) {
        # AR(1) on log lambda, log turnover and log psi, stationary at the batch's sds.
        # mu is reconstructed as lambda * turnover, so net diversification stays tied to
        # lambda instead of drifting independently.
        il <- LSD * sqrt(1 - OU_PHI^2)
        it <- TSD * sqrt(1 - OU_PHI^2)
        ip <- PSD * sqrt(1 - OU_PHI^2)
        log_lambda[1] ~ dnNormal(LMEAN, LSD)
        log_turn[1] ~ dnNormal(TMEAN, TSD)
        log_psi[1] ~ dnNormal(PMEAN, PSD)
        for (i in 2:n_int) {
            log_lambda[i] ~ dnNormal(LMEAN + OU_PHI * (log_lambda[i-1] - LMEAN), il)
            log_turn[i] ~ dnNormal(TMEAN + OU_PHI * (log_turn[i-1] - TMEAN), it)
            log_psi[i] ~ dnNormal(PMEAN + OU_PHI * (log_psi[i-1] - PMEAN), ip)
        }
        for (i in 1:n_int) {
            moves.append( mvSlide(log_lambda[i], delta=0.2, weight=1) )
            moves.append( mvSlide(log_turn[i], delta=0.2, weight=1) )
            moves.append( mvSlide(log_psi[i], delta=0.2, weight=1) )
            lambda[i] := exp(log_lambda[i])
            mu[i] := exp(log_lambda[i] + log_turn[i])
            psi[i] := exp(log_psi[i])
        }
    } else if (GMRF_SD > 0 || GMRF_HIER) {
        # The walk width is either fixed by the batch or, in the hierarchical variant,
        # drawn per replicate from the same lognormal the simulator used. It has to be
        # estimated here for the same reason the walk itself is: the ranks are
        # non-uniform by construction if the fitted prior is not the generating one.
        if (GMRF_HIER) {
            gmrf_sd_rates ~ dnLognormal(GMRF_SD_MEAN, GMRF_SD_SD)
            gmrf_sd_psi ~ dnLognormal(GMRF_PSI_MEAN, GMRF_PSI_SD)
            moves.append( mvScale(gmrf_sd_rates, lambda=0.5, weight=2) )
            moves.append( mvScale(gmrf_sd_psi, lambda=0.5, weight=2) )
        } else {
            gmrf_sd_rates <- GMRF_SD
            gmrf_sd_psi <- GMRF_SD
        }
        # order-1 GMRF on the log rates, anchored at the present and walking back through time.
        # The simulator draws from this same walk, or the ranks are non-uniform by construction.
        log_lambda[1] ~ dnNormal(LMEAN, LSD)
        log_mu[1] ~ dnNormal(MMEAN, MSD)
        log_psi[1] ~ dnNormal(PMEAN, PSD)
        for (i in 2:n_int) {
            log_lambda[i] ~ dnNormal(log_lambda[i-1], gmrf_sd_rates)
            log_mu[i] ~ dnNormal(log_mu[i-1], gmrf_sd_rates)
            log_psi[i] ~ dnNormal(log_psi[i-1], gmrf_sd_psi)
        }
        for (i in 1:n_int) {
            moves.append( mvSlide(log_lambda[i], delta=0.2, weight=1) )
            moves.append( mvSlide(log_mu[i], delta=0.2, weight=1) )
            moves.append( mvSlide(log_psi[i], delta=0.2, weight=1) )
            lambda[i] := exp(log_lambda[i])
            mu[i] := exp(log_mu[i])
            psi[i] := exp(log_psi[i])
        }
    } else {
    for (i in 1:n_int) {
        lambda[i] ~ dnLognormal(LMEAN, LSD)
        moves.append( mvSlice(lambda[i], window=0.1, weight=1, search_method="stepping_out") )
        mu[i] ~ dnLognormal(MMEAN, MSD)
        moves.append( mvSlice(mu[i], window=0.1, weight=1, search_method="stepping_out") )
        psi[i] ~ dnLognormal(PMEAN, PSD)
        moves.append( mvSlice(psi[i], window=0.1, weight=1, search_method="stepping_out") )
    }
    }
} else {
    lambda ~ dnLognormal(LMEAN, LSD)
    mu ~ dnLognormal(MMEAN, MSD)
    psi ~ dnLognormal(PMEAN, PSD)
    moves.append( mvScale(lambda, weight=3) )
    moves.append( mvScale(mu, weight=3) )
    moves.append( mvScale(psi, weight=3) )
}

# uniform is the simulator's own age draw, U(AGE_MIN, AGE_MAX). exponential is PyRate's:
# rate and lower truncation both the oldest observed first appearance, no upper bound.
# Truncating an exponential below at m and shifting it to m are the same thing, so the
# offset argument gives PyRate's prior exactly.
if (ORIGIN_PRIOR == "exponential") {
    org_prior = dnExponential(1/MAXFA, offset=MAXFA)
} else {
    org_prior = dnUniform(AGE_MIN, AGE_MAX)
}

if (SKYLINE) {
    bd ~ dnFBDRP(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=RHO, present=PRESENT,
                 timeline=timeline, condition=COND, origin_prior=org_prior, survivors=SURVIVORS)
} else {
    bd ~ dnFBDRP(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=RHO, present=PRESENT,
                 condition=COND, origin_prior=org_prior, survivors=SURVIVORS)
}

# the reporting model is its own node now, clamped to the observed record
# REPORT_PROB below 1 means the batch thinned the interior, so the rate is estimated rather
# than assumed. The extremes are always reported either way, which is what identifies it.
if (REPORT_PROB < 1.0) {
    reporting ~ dnBeta(1.0, 1.0)
    moves.append( mvSlide(reporting, delta=0.1, weight=5) )
    moves.append( mvBetaProbability(reporting, delta=2.0, weight=5) )
    rec ~ dnFossilRecord(ranges=bd, reporting=reporting)
} else {
    rec ~ dnFossilRecord(ranges=bd, complete=COMPLETE)
}
rec.clamp(taxa)

moves.append( mvMatrixElementScale(bd, lambda=0.01, weight=taxa.size()/10) )
moves.append( mvMatrixElementScale(bd, lambda=0.1,  weight=taxa.size()/10) )
moves.append( mvMatrixElementScale(bd, lambda=1,    weight=taxa.size()/10) )
moves.append( mvMatrixElementSlide(bd, delta=0.01, weight=taxa.size()/10) )
moves.append( mvMatrixElementSlide(bd, delta=0.1,  weight=taxa.size()/10) )
moves.append( mvMatrixElementSlide(bd, delta=1,    weight=taxa.size()/10) )

# lets the oldest birth change lineage, which a random walk mixes over poorly
moves.append( mvMatrixElementSwap(bd, col=4, weight=taxa.size()/5) )

# rho < 1 puts a point mass at the present on every taxon reported extinct, which the
# continuous element moves cannot reach
if (RHO < 1.0 && SURVIVORS) {
    moves.append( mvExtinctionRJSwitch(bd, weight=taxa.size()/5) )
}

org  := bd.getOrigin()
bb   := bd.getOriginationTimes()
dd   := bd.getExtinctionTimes()
tau1 := bd.getFirstAppearances()
tauK := bd.getLastAppearances()

mymodel = model(bd)
monitors = VectorMonitors()
monitors.append( mnModel(filename=OUTDIR + "/rep_" + rep + ".log", printgen=PRINTGEN) )
monitors.append( mnScreen(printgen=100000) )
mymcmc = mcmc(mymodel, monitors, moves, moveschedule="single")
mymcmc.run(generations=GENS)
q()
