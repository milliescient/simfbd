### Skyline birth-death-sampling inference over dnBDS, with the record on a dnFossilRecord node.
###
### The counterpart to bin/infer.Rev: same data, same priors, same reporting split, but a
### process that assumes complete lineage sampling. There is no p(), no survival term and
### no attachment count, so the comparison against dnFBDRP isolates exactly that assumption.
###
### Set before sourcing: rep, SKYLINE, COMPLETE, COND, RHO, GENS, PRINTGEN,
###   SPECIMENS, BATCHDIR, OUTDIR, LMEAN, LSD, MMEAN, MSD, PMEAN, PSD

taxa <- readTaxonData(BATCHDIR + "/" + SPECIMENS + "/taxa_" + rep + ".tsv")

moves = VectorMoves()

if (SKYLINE) {
    timeline <- readDataDelimitedFile(BATCHDIR + "/times/times_" + rep + ".tsv")[1]
    n_int <- timeline.size() + 1
    for (i in 1:n_int) {
        lambda[i] ~ dnLognormal(LMEAN, LSD)
        moves.append( mvSlice(lambda[i], window=0.1, weight=1, search_method="stepping_out") )
        mu[i] ~ dnLognormal(MMEAN, MSD)
        moves.append( mvSlice(mu[i], window=0.1, weight=1, search_method="stepping_out") )
        psi[i] ~ dnLognormal(PMEAN, PSD)
        moves.append( mvSlice(psi[i], window=0.1, weight=1, search_method="stepping_out") )
    }
    bd ~ dnBDS(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=RHO,
               timeline=timeline, condition=COND)
} else {
    lambda ~ dnLognormal(LMEAN, LSD)
    mu ~ dnLognormal(MMEAN, MSD)
    psi ~ dnLognormal(PMEAN, PSD)
    moves.append( mvScale(lambda, weight=3) )
    moves.append( mvScale(mu, weight=3) )
    moves.append( mvScale(psi, weight=3) )
    bd ~ dnBDS(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=RHO, condition=COND)
}

# the reporting term is its own node, as for dnFBDRP
rec ~ dnFossilRecord(ranges=bd, complete=COMPLETE)
rec.clamp(taxa)

moves.append( mvMatrixElementScale(bd, lambda=0.01, weight=taxa.size()/10) )
moves.append( mvMatrixElementScale(bd, lambda=0.1,  weight=taxa.size()/10) )
moves.append( mvMatrixElementScale(bd, lambda=1,    weight=taxa.size()/10) )
moves.append( mvMatrixElementSlide(bd, delta=0.01, weight=taxa.size()/10) )
moves.append( mvMatrixElementSlide(bd, delta=0.1,  weight=taxa.size()/10) )
moves.append( mvMatrixElementSlide(bd, delta=1,    weight=taxa.size()/10) )

bb   := bd.getOriginationTimes()
dd   := bd.getExtinctionTimes()
tau1 := bd.getFirstAppearances()
tauK := bd.getLastAppearances()

mymodel = model(bd)
monitors = VectorMonitors()
monitors.append( mnModel(filename=OUTDIR + "/skyfbdr_" + rep + ".log", printgen=PRINTGEN) )
monitors.append( mnScreen(printgen=100000) )
mymcmc = mcmc(mymodel, monitors, moves, moveschedule="single")
mymcmc.run(generations=GENS)
q()
