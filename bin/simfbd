#!/bin/bash
# simfbd: simulate batches of fossil records and fit them.
#
#   simfbd extend <batch> <n>          add n replicates to a batch, or give a new one its first
#   simfbd fit <batch>/runs/<name>     fit every replicate of the batch not yet fitted
#   simfbd status <batch or run> ...   does it still match its manifest
#   simfbd summarize <run> ...         SBC ranks, coverage and diagnostics for a run
#   simfbd ranks <run>                 mean rank per parameter
#   simfbd --version                   the commit of this code, -dirty if it has uncommitted changes
#
# A batch is a directory holding a config.sh, anywhere on disk. This script can be called by
# its path or linked onto PATH; it finds the rest of bin/ beside itself.
set -u
BIN="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$BIN/env.sh"
export PY RSCRIPT RBIN
usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; }
cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  extend)    exec bash "$BIN/extend.sh" "$@" ;;
  fit)       case "${1:-}" in */runs/*) exec bash "$BIN/run.sh" "$@" ;;
               *) echo "error: fit takes a run, <batch>/runs/<name>" >&2; exit 1 ;; esac ;;
  status)    [ $# -gt 0 ] || { usage >&2; exit 1; }; exec "$PY" "$BIN/manifest.py" status "$@" ;;
  summarize) exec "$RSCRIPT" "$BIN/summarize.R" "$@" ;;
  ranks)     exec "$PY" "$BIN/ranks.py" "$@" ;;
  # the same words bin/run.sh records in a manifest, so the two can be compared as text
  --version|version) git -C "$BIN" describe --always --dirty --tags 2>/dev/null || echo none ;;
  ""|-h|--help|help) usage ;;
  *) echo "error: no such command: $cmd" >&2; usage >&2; exit 1 ;;
esac
